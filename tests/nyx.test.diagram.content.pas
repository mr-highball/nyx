unit nyx.test.diagram.content;

{$mode delphi}{$H+}{$codepage utf8}

interface

uses nyx.model;

{ Own the returned English source document. Its embedded raster is generated by
  the maintained Pascal fixture tool; no HTTP request or target control is used.
  The hosted descriptor is metadata only and has an explicit embedded fallback. }
function DiagramContentDocument: TNyxDocument;

implementation

uses nyx.text, nyx.types, nyx.controls, nyx.images, nyx.resources,
  nyx.resource.sources, nyx.image.fixtures, nyx.state, nyx.diagram,
  nyx.diagram.content, nyx.diagram.declarations, nyx.canvas.geometry, nyx.drawing;

function DiagramContentDocument: TNyxDocument;
var
  LDetails: INyxColumn;
  LAlternate: INyxColumn;
  LMemo: INyxMemo;
  LLabel: INyxLabel;
  LButton: INyxButton;
  LDiagram: INyxDiagram;
begin
  Result := TNyxDocument.Create;
  try
    Result.Title := 'Diagram content workshop';
    Result.AddPage(NewNyxPage('home'));
    Result.State.SetValue(NyxTextState('reply'), 'Write a thoughtful reply');
    Result.State.SetValue(NyxIntegerState('replies'), 0);
    Result.Resources.Define(NyxResourceRef('Tile image'),
      NyxImageResource(NyxEmbeddedImage(nimPNG, ImagePNG))
        .Describe('Color tile', 'A packed image used inside a diagram shape.'));
    Result.Resources.Define(NyxResourceRef('Hosted tile'),
      NyxHostedResource(nrkImage, NyxResourceURL('https://example.invalid/tile.png'))
        .Fallback(NyxImageResource(NyxEmbeddedImage(nimPNG, ImagePNG))));
    LDetails := NewNyxColumn('Details');
    LDetails.Configure.Padding(12).Gap(10).Done;
    LLabel := NewNyxLabel('details-heading').WithText('A live Nyx form');
    LDetails.Add(LLabel);
    LMemo := NewNyxMemo('details-reply').WithText('Reply');
    LMemo.Configure.Height(80).MinimumHeight(0).WidthSizing(nsFill).Done;
    LMemo.Binds.Value(NyxTextState('reply'));
    LDetails.Add(LMemo);
    LButton := NewNyxButton('details-send').WithText('Add reply');
    LDetails.Add(LButton);
    Result.AddComponent(LDetails);
    LAlternate := NewNyxColumn('Summary');
    LAlternate.Add(NewNyxLabel('summary-heading').WithText('A different reusable'));
    LAlternate.Add(NewNyxButton('summary-button').WithText('Continue'));
    Result.AddComponent(LAlternate);
    { Valid portable intent can still lack a runtime capability. The content
      journey uses this template to exercise failed physical staging, after
      document admission and before any visible membership is replaced. }
    Result.AddComponent(NewNyxDrawing('Unavailable drawing')
      .WithProvider(NyxDrawingProvider('Fixture missing drawing provider')));
    LDiagram := NewNyxDiagram
      .WithVertex(NyxDiagramVertex(NyxDiagramVertexRef('Image'), ndsRectangle,
        NyxCanvasBounds(-260, -100, 240, 220)).Captioned('Resource image')
        .WithContent(NyxDiagramImage(NyxResourceImage(NyxResourceRef('Tile image')))
          .Padded(12).Fitted(nifContain).CaptionSpace(32)))
      .WithVertex(NyxDiagramVertex(NyxDiagramVertexRef('Form'), ndsRectangle,
        NyxCanvasBounds(80, -100, 320, 260)).Captioned('Reusable form')
        .WithContent(NyxDiagramComponent(NyxComponent('Details')).Padded(12).CaptionSpace(32)))
      .WithEdge(NyxDiagramEdge(NyxDiagramEdgeRef('Continue'),
        NyxDiagramAttached(NyxDiagramVertexRef('Image'), ndaRight),
        NyxDiagramAttached(NyxDiagramVertexRef('Form'), ndaLeft)).Routed(ndrOrthogonal));
    Result.Diagrams.Define(NyxDiagramRef('Content board'), LDiagram);
    Result.Validate;
  except
    Result.Free;
    raise;
  end;
end;

end.
