{
  "layout": [
    {
      "op": "title",
      "value": "Find your next destination"
    },
    {
      "op": "create",
      "root": "page",
      "kind": "page",
      "id": "typeahead-review",
      "properties": {
        "gap": 16,
        "padding": 24
      }
    },
    {
      "op": "create",
      "parent": "typeahead-review",
      "kind": "heading",
      "id": "review-heading",
      "properties": {
        "text": "Find your next destination"
      }
    },
    {
      "op": "create",
      "parent": "typeahead-review",
      "kind": "label",
      "id": "review-help",
      "properties": {
        "text": "Focus a list or tree, then type a place name. Repeat a letter to find the next match."
      }
    },
    {
      "op": "create",
      "parent": "typeahead-review",
      "kind": "list",
      "id": "destination-list",
      "properties": {
        "text": "Destinations",
        "height": 210,
        "aria-label": "Destinations"
      }
    },
    {
      "op": "create",
      "parent": "typeahead-review",
      "kind": "tree",
      "id": "destination-tree",
      "properties": {
        "text": "Destination groups",
        "height": 220,
        "aria-label": "Destination groups"
      }
    }
