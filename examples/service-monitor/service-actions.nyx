{ "version" : 1, "design" : "{ \"version\" : 6, \"menus\" : { \"version\" : 1, \"definitions\" : [{ \"name\" : \"service-actions-menu\", \"definition\" : { \"root\" : { \"kind\" : \"component\", \"name\" : \"service-actions-menu\" }, \"options\" : { \"title\" : \"Service actions\", \"side\" : \"below\", \"alignment\" : \"start\", \"sizing\" : \"content\", \"width\" : 320, \"height\" : 200, \"gap\" : 6, \"margin\" : 12, \"focus\" : \"\", \"escape\" : true, \"outsidePress\" : true, \"opening\" : \"first\", \"wrap\" : true, \"searchEnabled\" : true, \"searchWindowMS\" : 800, \"searchMatch\" : \"folded\" }, \"items\" : [{ \"kind\" : \"action\", \"part\" : \"mark-review\", \"command\" : \"mark-review\", \"group\" : \"\", \"checked\" : false, \"enabled\" : true, \"submenu\" : \"\" }] } }] }, \"presentations\" : { \"version\" : 1, \"definitions\" : [] }, \"collections\" : { \"version\" : 1, \"definitions\" : [{ \"key\" : \"services\", \"schema\" : [{ \"name\" : \"name\", \"default\" : { \"type\" : \"text\", \"value\" : \"\" }, \"domain\" : { \"type\" : \"text\" } }, { \"name\" : \"pid\", \"default\" : { \"type\" : \"integer\", \"value\" : 0 }, \"domain\" : { \"type\" : \"integer\" } }, { \"name\" : \"command\", \"default\" : { \"type\" : \"text\", \"value\" : \"\" }, \"domain\" : { \"type\" : \"text\" } }, { \"name\" : \"notes\", \"default\" : { \"type\" : \"text\", \"value\" : \"\" }, \"domain\" : { \"type\" : \"text\" } }, { \"name\" : \"status\", \"default\" : { \"type\" : \"text\", \"value\" : \"\" }, \"domain\" : { \"type\" : \"text\" } }], \"items\" : [{ \"id\" : \"gateway\", \"values\" : [\"Request gateway\", 2401, \"/opt/example/bin/gateway --listen=127.0.0.1 --config=/opt/example/config/gateway.json\", \"Accepts incoming requests and routes them to healthy workers.\", \"Running\"] }, { \"id\" : \"indexer\", \"values\" : [\"Search index worker\", 2408, \"/opt/example/bin/indexer --collection=documents --batch-size=128\", \"Waiting for new documents. Edit this note to try draft handling.\", \"Idle\"] }, { \"id\" : \"archive\", \"values\" : [\"Archive and retention worker\", 2420, \"/opt/example/bin/archive --destination=/var/example/archive --retention-days=30\", \"The destination is temporarily unavailable. Full-value inspection keeps this explanation readable without narrowing the entire workspace.\", \"Attention\"] }, { \"id\" : \"reports\", \"values\" : [\"Report scheduler\", 2427, \"/opt/example/bin/reports --schedule=hourly\", \"The next report is ready to run.\", \"Running\"] }] }] }, \"title\" : \"Service monitor\", \"state\" : { \"service-context-summary\" : { \"type\" : \"text\", \"value\" : \"Choose a service cell to inspect its context.\" }, \"service-context-id\" : { \"type\" : \"text\", \"value\" : \"\" }, \"service-context-revision\" : { \"type\" : \"integer\", \"value\" : -1 }, \"service-context-ready\" : { \"type\" : \"boolean\", \"value\" : false } }, \"pages\" : [{ \"kind\" : \"page\", \"id\" : \"services\", \"props\" : { \"layout\" : \"column\", \"padding\" : \"16\", \"gap\" : \"16\" }, \"children\" : [{ \"kind\" : \"heading\", \"id\" : \"service-title\", \"props\" : { \"text\" : \"A clearer view of your services\" }, \"children\" : [] }, { \"kind\" : \"label\", \"id\" : \"service-introduction\", \"props\" : { \"text\" : \"Sample services, real table controls. Filter a column, arrange your workspace, or edit a name, note or status.\" }, \"children\" : [] }, { \"kind\" : \"label\", \"id\" : \"service-context-summary\", \"props\" : { \"text\" : \"Choose a service cell to inspect its context.\" }, \"bindings\" : [{ \"property\" : \"text\", \"state\" : \"service-context-summary\", \"type\" : \"text\", \"direction\" : \"from-state\" }], \"children\" : [] }, { \"kind\" : \"button\", \"id\" : \"service-actions-button\", \"menu\" : \"service-actions-menu\", \"props\" : { \"text\" : \"Service actions\", \"variant\" : \"secondary\" }, \"bindings\" : [{ \"property\" : \"enabled\", \"state\" : \"service-context-ready\", \"type\" : \"boolean\", \"direction\" : \"from-state\" }], \"children\" : [], \"nyx.callbacks\" : { \"version\" : 1, \"events\" : [{ \"trigger\" : \"named\", \"name\" : \"activate\", \"policy\" : \"sequential\", \"callbacks\" : [{ \"id\" : \"TServiceActionsButtonActivate\", \"handler\" : \"TServiceActionsButtonActivate\" }] }] } }, { \"kind\" : \"table\", \"id\" : \"service-table\", \"props\" : { \"height\" : \"480\", \"aria-label\" : \"Service records\" }, \"collectionView\" : { \"version\" : 11, \"key\" : \"services\", \"scope\" : \"application\", \"parent\" : \"\", \"columns\" : [{ \"field\" : \"name\", \"kind\" : \"text\", \"title\" : \"Service\", \"editable\" : true, \"sizing\" : { \"version\" : 1, \"mode\" : \"fixed\", \"value\" : 160, \"minimum\" : 112, \"maximum\" : 420 }, \"queryControls\" : null, \"layoutControls\" : { \"version\" : 1, \"visible\" : true, \"pin\" : \"start\", \"features\" : [\"resize\", \"auto-size\", \"reorder\", \"visibility\", \"pinning\"] }, \"display\" : null, \"textPresentation\" : { \"version\" : 1, \"overflow\" : \"ellipsis\", \"maximumLines\" : 1 } }, { \"field\" : \"notes\", \"kind\" : \"text\", \"title\" : \"Notes\", \"editable\" : true, \"sizing\" : { \"version\" : 1, \"mode\" : \"fixed\", \"value\" : 320, \"minimum\" : 160, \"maximum\" : 800 }, \"queryControls\" : null, \"layoutControls\" : null, \"display\" : null, \"textPresentation\" : { \"version\" : 1, \"overflow\" : \"wrap\", \"maximumLines\" : 3 } }, { \"field\" : \"pid\", \"kind\" : \"integer\", \"title\" : \"Process ID\", \"editable\" : false, \"sizing\" : { \"version\" : 1, \"mode\" : \"fixed\", \"value\" : 104, \"minimum\" : 80, \"maximum\" : 180 }, \"queryControls\" : null, \"layoutControls\" : null, \"display\" : null, \"textPresentation\" : null }, { \"field\" : \"command\", \"kind\" : \"text\", \"title\" : \"Command line\", \"editable\" : false, \"sizing\" : { \"version\" : 1, \"mode\" : \"fixed\", \"value\" : 360, \"minimum\" : 160, \"maximum\" : 800 }, \"queryControls\" : null, \"layoutControls\" : { \"version\" : 1, \"visible\" : false, \"pin\" : \"none\", \"features\" : [\"resize\", \"auto-size\", \"reorder\", \"visibility\", \"pinning\"] }, \"display\" : null, \"textPresentation\" : { \"version\" : 1, \"overflow\" : \"ellipsis\", \"maximumLines\" : 1 } }, { \"field\" : \"status\", \"kind\" : \"text\", \"title\" : \"Status\", \"editable\" : true, \"sizing\" : { \"version\" : 1, \"mode\" : \"fixed\", \"value\" : 96, \"minimum\" : 80, \"maximum\" : 240 }, \"queryControls\" : null, \"layoutControls\" : { \"version\" : 1, \"visible\" : true, \"pin\" : \"end\", \"features\" : [\"resize\", \"auto-size\", \"reorder\", \"visibility\", \"pinning\"] }, \"display\" : null, \"textPresentation\" : null }], \"selection\" : \"single\", \"query\" : null, \"typeAhead\" : null, \"paging\" : null, \"queryControls\" : null, \"layoutControls\" : { \"version\" : 1, \"enabled\" : true, \"features\" : [\"resize\", \"auto-size\", \"reorder\", \"visibility\", \"pinning\"], \"minimumCenter\" : 80, \"autoSizeRows\" : 32 }, \"workbench\" : { \"version\" : 2, \"rangeSelection\" : true, \"copyActions\" : [\"cell\", \"selected-source\", \"selected-page\", \"cell-range\"], \"copyFields\" : \"visible-presentation\", \"headers\" : true, \"lineEnding\" : \"lf\", \"focusedDraft\" : false, \"export\" : { \"version\" : 1, \"actions\" : [\"current-page\", \"all-filtered\"], \"fields\" : \"visible-presentation\", \"headers\" : true, \"lineEnding\" : \"lf\" } }, \"tablePresentation\" : { \"version\" : 2, \"density\" : \"comfortable\", \"header\" : { \"version\" : 1, \"lines\" : 1, \"minimumHeight\" : 32 } } }, \"children\" : [], \"nyx.callbacks\" : { \"version\" : 1, \"events\" : [{ \"trigger\" : \"context-menu\", \"policy\" : \"sequential\", \"callbacks\" : [{ \"id\" : \"TServiceTableContextMenu\", \"handler\" : \"TServiceTableContextMenu\" }] }] } }, { \"kind\" : \"label\", \"id\" : \"service-help\", \"props\" : { \"text\" : \"Use column controls to resize, reorder, hide, pin or restore defaults. Service and Status start pinned at opposite edges. Cell actions offer inspection, copying and TSV export. Shift+Page Up or Page Down extends selected cells by the visible page. Escape clears the range.\" }, \"children\" : [] }] }], \"components\" : [{ \"kind\" : \"column\", \"id\" : \"service-actions-menu\", \"props\" : { \"layout\" : \"column\", \"gap\" : \"4\", \"padding\" : \"8\" }, \"children\" : [{ \"kind\" : \"button\", \"id\" : \"mark-service-review\", \"props\" : { \"text\" : \"Mark for review\", \"variant\" : \"primary\", \"part\" : \"mark-review\" }, \"children\" : [] }] }] }", "source" : "{ Service workspace: keep this handwritten comment. }\n{ Nyx application views. BuildNyxDocument returns an owned document. }\nunit nyx.generated.view;\n\n{$mode delphi}{$H+}\n{$codepage utf8}\n\ninterface\n\nuses\n  nyx.text,\n  nyx.dates,\n  nyx.times,\n  nyx.colors,\n  nyx.images,\n  nyx.button.presentation,\n  nyx.button.configuration,\n  nyx.image.lifecycle,\n  nyx.design.tokens,\n  nyx.types,\n  nyx.responsive,\n  nyx.presentations,\n  nyx.content,\n  nyx.containers,\n  nyx.editing,\n  nyx.gestures,\n  nyx.contract,\n  nyx.flow.declarations,\n  nyx.flow.routes, nyx.flow.route.model,\n  nyx.data.rows,\n  nyx.flow.types,\n  nyx.flow,\n  nyx.logic,\n  nyx.logic.collections,\n  nyx.logic.json.editing,\n  nyx.logic.relations,\n  nyx.logic.joins,\n  nyx.logic.regex, nyx.regex.types, nyx.regex.replacement,\n  nyx.logic.programs,\n  nyx.numbers.decimal,\n  nyx.logic.http, nyx.http.types,\n  nyx.logic.files, nyx.files.save,\n  nyx.drawing,\n  nyx.canvas.geometry,\n  nyx.data,\n  nyx.state,\n  nyx.collections.view.types,\n  nyx.collections.columns,\n  nyx.collections.arrangement,\n  nyx.collections.workbench.policy,\n  nyx.collections.presentation,\n  nyx.collections.selection,\n  nyx.collections.query,\n  nyx.collections,\n  nyx.collections.registry,\n  nyx.binding.types,\n  nyx.behavior,\n  nyx.scheduler,\n  nyx.events,\n  nyx.callbacks,\n  nyx.model,\n  nyx.controls,\n  nyx.typeahead,\n  nyx.menu.declarations,\n  nyx.menu.bar.declarations,\n  nyx.menu.types,\n  nyx.popover.types,\n  nyx.root.types;\n\nfunction BuildNyxDocument: TNyxDocument;\n\nimplementation\n\nuses\n  nyx.menu;\n\n// <nyx:views>\n// Studio synchronizes this builder; keep application helpers outside it.\nfunction BuildNyxDocument: TNyxDocument;\nvar\n  LServiceContextSummaryTextState: TNyxTextStateRef;\n  LServiceContextIdTextState: TNyxTextStateRef;\n  LServiceContextRevisionIntegerState: TNyxIntegerStateRef;\n  LServiceContextReadyBooleanState: TNyxBooleanStateRef;\n  LServicesPage: INyxPage;\n  LServiceTitleHeading: INyxHeading;\n  LServiceIntroductionLabel: INyxLabel;\n  LServiceContextSummaryLabel: INyxLabel;\n  LServiceActionsButton: INyxButton;\n  LServiceTable: INyxTable;\n  LServiceHelpLabel: INyxLabel;\n  LServiceActionsMenuColumn: INyxColumn;\n  LMarkServiceReviewButton: INyxButton;\nbegin\n  Result := TNyxDocument.Create;\n  try\n    // Admit each control to its owner before configuring it.\n    // A failed configuration releases the complete owned document.\n    Result.Title := 'Service monitor';\n\n    // Named references give defaults and their controls one typed contract.\n    LServiceContextSummaryTextState := NyxTextState('service-context-summary');\n    LServiceContextIdTextState := NyxTextState('service-context-id');\n    LServiceContextRevisionIntegerState := NyxIntegerState('service-context-revision');\n    LServiceContextReadyBooleanState := NyxBooleanState('service-context-ready');\n\n    // Authored defaults; each application owns its runtime copy.\n    Result.State\n      .SetValue(LServiceContextSummaryTextState, 'Choose a service cell to inspect its context.')\n      .SetValue(LServiceContextIdTextState, '')\n      .SetValue(LServiceContextRevisionIntegerState, -1)\n      .SetValue(LServiceContextReadyBooleanState, False);\n\n    // Authored collection defaults; each application owns independent runtime stores.\n    Result.Collections.Define(\n      NyxCollection('services'),\n      NyxCollectionSchema\n        .Text(NyxTextField('name'), '', NyxTextDomain)\n        .Integer(NyxIntegerField('pid'), 0, NyxIntegerDomain)\n        .Text(NyxTextField('command'), '', NyxTextDomain)\n        .Text(NyxTextField('notes'), '', NyxTextDomain)\n        .Text(NyxTextField('status'), '', NyxTextDomain),\n      [\n        NyxCollectionItem(NyxItem(NyxCollection('services'), 'gateway'))\n          .WithValue(NyxTextField('name'), 'Request gateway')\n          .WithValue(NyxIntegerField('pid'), 2401)\n          .WithValue(NyxTextField('command'), '/opt/example/bin/gateway --listen=127.0.0.1 --config=/opt/example/config/gateway.json')\n          .WithValue(NyxTextField('notes'), 'Accepts incoming requests and routes them to healthy workers.')\n          .WithValue(NyxTextField('status'), 'Running'),\n        NyxCollectionItem(NyxItem(NyxCollection('services'), 'indexer'))\n          .WithValue(NyxTextField('name'), 'Search index worker')\n          .WithValue(NyxIntegerField('pid'), 2408)\n          .WithValue(NyxTextField('command'), '/opt/example/bin/indexer --collection=documents --batch-size=128')\n          .WithValue(NyxTextField('notes'), 'Waiting for new documents. Edit this note to try draft handling.')\n          .WithValue(NyxTextField('status'), 'Idle'),\n        NyxCollectionItem(NyxItem(NyxCollection('services'), 'archive'))\n          .WithValue(NyxTextField('name'), 'Archive and retention worker')\n          .WithValue(NyxIntegerField('pid'), 2420)\n          .WithValue(NyxTextField('command'), '/opt/example/bin/archive --destination=/var/example/archive --retention-days=30')\n          .WithValue(NyxTextField('notes'), 'The destination is temporarily unavailable. Full-value inspection keeps this explanation readable without narrowing the entire workspace.')\n          .WithValue(NyxTextField('status'), 'Attention'),\n        NyxCollectionItem(NyxItem(NyxCollection('services'), 'reports'))\n          .WithValue(NyxTextField('name'), 'Report scheduler')\n          .WithValue(NyxIntegerField('pid'), 2427)\n          .WithValue(NyxTextField('command'), '/opt/example/bin/reports --schedule=hourly')\n          .WithValue(NyxTextField('notes'), 'The next report is ready to run.')\n          .WithValue(NyxTextField('status'), 'Running')\n      ]);\n\n\n    LServicesPage := NewNyxPage('services');\n    Result.AddPage(LServicesPage);\n    LServicesPage.Configure\n      .Layout(nlColumn)\n      .Padding(16)\n      .Gap(16)\n      .Done;\n\n    LServiceTitleHeading := NewNyxHeading('service-title');\n    LServicesPage.Add(LServiceTitleHeading);\n    LServiceTitleHeading.Configure\n      .Text('A clearer view of your services')\n      .Done;\n\n    LServiceIntroductionLabel := NewNyxLabel('service-introduction');\n    LServicesPage.Add(LServiceIntroductionLabel);\n    LServiceIntroductionLabel.Configure\n      .Text('Sample services, real table controls. Filter a column, arrange your workspace, or edit a name, note or status.')\n      .Done;\n\n    LServiceContextSummaryLabel := NewNyxLabel('service-context-summary');\n    LServicesPage.Add(LServiceContextSummaryLabel);\n    LServiceContextSummaryLabel.Configure\n      .Text('Choose a service cell to inspect its context.')\n      .Done;\n    LServiceContextSummaryLabel.Binds\n      .Text(LServiceContextSummaryTextState)\n      .Done;\n\n    LServiceActionsButton := NewNyxButton('service-actions-button');\n    LServicesPage.Add(LServiceActionsButton);\n    LServiceActionsButton.Configure\n      .Menu(NyxMenuRef('service-actions-menu'))\n      .Text('Service actions')\n      .Variant(nvSecondary)\n      .Done;\n    LServiceActionsButton.Binds\n      .Enabled(LServiceContextReadyBooleanState)\n      .Done;\n\n    NyxCallbacks(LServiceActionsButton).OnNamed(NyxSemantic(nseActivate))\n      .Policy(neSequential)\n      .Add(NyxHandler('TServiceActionsButtonActivate'), NyxCallbackID('TServiceActionsButtonActivate'));\n\n    LServiceTable := NewNyxTable('service-table');\n    LServicesPage.Add(LServiceTable);\n    LServiceTable.Configure\n      .Height(480)\n      .AccessibleName('Service records')\n      .Done;\n    LServiceTable.Binds\n      .Collection(\n        NyxCollectionView(NyxCollection('services'))\n          .Column(NyxTextField('name'), 'Service', cmEditable)\n          .ColumnSizing(NyxColumnSizing.Fixed(160).Minimum(112).Maximum(420))\n          .ColumnLayout(NyxColumnLayout.PinStart())\n          .ColumnText(NyxColumnText.Ellipsis)\n          .Column(NyxTextField('notes'), 'Notes', cmEditable)\n          .ColumnSizing(NyxColumnSizing.Fixed(320).Minimum(160).Maximum(800))\n          .ColumnText(NyxColumnText.Wrap(3))\n          .Column(NyxIntegerField('pid'), 'Process ID')\n          .ColumnSizing(NyxColumnSizing.Fixed(104).Minimum(80).Maximum(180))\n          .Column(NyxTextField('command'), 'Command line')\n          .ColumnSizing(NyxColumnSizing.Fixed(360).Minimum(160).Maximum(800))\n          .ColumnLayout(NyxColumnLayout.Visible(False))\n          .ColumnText(NyxColumnText.Ellipsis)\n          .Column(NyxTextField('status'), 'Status', cmEditable)\n          .ColumnSizing(NyxColumnSizing.Fixed(96).Minimum(80).Maximum(240))\n          .ColumnLayout(NyxColumnLayout.PinEnd())\n          .TableLayout(NyxTableLayout.MinimumCenter(80).AutoSizeSample(32))\n          .TablePresentation(NyxTablePresentation.Density(ntrdComfortable)\n            .Header(NyxTableHeader.Lines(1)\n              .MinimumHeight(32)))\n          .TableWorkbench(NyxTableWorkbench\n            .RangeSelection(True)\n            .AllowCopy([nwcaCell, nwcaSelectedSource, nwcaSelectedPage, nwcaCellRange])\n            .Export(NyxTableExport\n              .Allow([nweaCurrentPage, nweaAllFiltered]))))\n      .Done;\n\n    NyxCallbacks(LServiceTable).OnContextMenu\n      .Policy(neSequential)\n      .Add(NyxHandler('TServiceTableContextMenu'), NyxCallbackID('TServiceTableContextMenu'));\n\n    LServiceHelpLabel := NewNyxLabel('service-help');\n    LServicesPage.Add(LServiceHelpLabel);\n    LServiceHelpLabel.Configure\n      .Text('Use column controls to resize, reorder, hide, pin or restore defaults. Service and Status start pinned at opposite edges. Cell actions offer inspection, copying and TSV export. Shift+Page Up or Page Down extends selected cells by the visible page. Escape clears the range.')\n      .Done;\n\n    LServiceActionsMenuColumn := NewNyxColumn('service-actions-menu');\n    Result.AddComponent(LServiceActionsMenuColumn);\n    LServiceActionsMenuColumn.Configure\n      .Layout(nlColumn)\n      .Gap(4)\n      .Padding(8)\n      .Done;\n\n    LMarkServiceReviewButton := NewNyxButton('mark-service-review');\n    LServiceActionsMenuColumn.Add(LMarkServiceReviewButton);\n    LMarkServiceReviewButton.Configure\n      .Text('Mark for review')\n      .Variant(nvPrimary)\n      .PartName(NyxPart('mark-review'))\n      .Done;\n\n    Result.Menus.Define(\n      NyxMenuRef('service-actions-menu'),\n      NewNyxMenuDefinition(\n        NyxReusableRoot('service-actions-menu'),\n        NyxMenu('Service actions')\n          .Opening(nmoFirst)\n          .Wrap(True)\n          .TypeAhead(NyxTypeAhead\n            .Enabled(True)\n            .WindowMilliseconds(800)\n            .Match(ntmFolded))\n          .Presentation(NyxPopover('Service actions')\n            .Placement(npsBelow, npaStart)\n            .Sizing(npzContent)\n            .Size(320, 200)\n            .Spacing(6, 12)\n            .DismissOn([npdEscape, npdOutsidePress])))\n        .Action(NyxPart('mark-review'), NyxMenuCommand('mark-review'), True));\n  except\n    Result.Free;\n    raise;\n  end;\nend;\n// </nyx:views>\n\n\ntype\n  { Application callback for context-menu.\n    AEvent owns its payload. Context provides revocable runtime stores;\n    capture owned inputs on UI before submitting parent-linked worker jobs. }\n  TServiceTableContextMenu = class(TNyxApplicationEventCallback)\n  public\n    procedure Invoke(const AEvent: TNyxEventInfo;\n      const AExecution: INyxExecution); override;\n  end;\n\nprocedure TServiceTableContextMenu.Invoke(const AEvent: TNyxEventInfo;\n  const AExecution: INyxExecution);\nbegin\n\n  if AExecution.Cancelled or not AEvent.HasCollectionCell then\n  begin\n    Exit;\n  end;\n  { Capture the accepted cell once. The action uses this original identity and\n    revision, never a later selection or widget lookup. State admission is atomic. }\n  Context.State.Apply([\n    NyxStateValue(NyxTextState('service-context-summary'),\n      TNyxText('Service ') + AEvent.CollectionCell.Item.ID + TNyxText(' / ') +\n      AEvent.CollectionCell.Field.Name),\n    NyxStateValue(NyxTextState('service-context-id'), AEvent.CollectionCell.Item.ID),\n    NyxStateValue(NyxIntegerState('service-context-revision'), AEvent.CollectionCell.Revision),\n    NyxStateValue(NyxBooleanState('service-context-ready'), True)]);\nend;\n\n\ntype\n  { Application callback for \"activate\".\n    AEvent owns its payload. Context provides revocable runtime stores;\n    capture owned inputs on UI before submitting parent-linked worker jobs. }\n  TServiceActionsButtonActivate = class(TNyxApplicationEventCallback)\n  public\n    procedure Invoke(const AEvent: TNyxEventInfo;\n      const AExecution: INyxExecution); override;\n  end;\n\nprocedure TServiceActionsButtonActivate.Invoke(const AEvent: TNyxEventInfo;\n  const AExecution: INyxExecution);\nconst\n  CMarkReview: TNyxText = 'mark-review';\nvar\n  LInvocation: TNyxMenuInvocation;\n  LStore: INyxCollection;\n  LItem: TNyxItemRef;\n  LRevision: Integer;\nbegin\n\n  if AExecution.Cancelled then\n  begin\n    Exit;\n  end;\n  LInvocation := NyxMenuInvocation(AEvent);\n\n  if (LInvocation.Command.Name <> CMarkReview) or\n    not Context.State.GetValue(NyxBooleanState('service-context-ready')) then\n  begin\n    Exit;\n  end;\n  LStore := Context.Collections.Collection(NyxCollection('services'));\n  LRevision := Context.State.GetValue(NyxIntegerState('service-context-revision'));\n\n  if LStore.Snapshot.Revision <> LRevision then\n  begin\n    Context.State.Apply([\n      NyxStateValue(NyxTextState('service-context-summary'),\n        'Services changed. Choose a cell again before marking it for review.'),\n      NyxStateValue(NyxBooleanState('service-context-ready'), False)]);\n    Exit;\n  end;\n  LItem := NyxItem(NyxCollection('services'),\n    Context.State.GetValue(NyxTextState('service-context-id')));\n  { The application owns this store. Expected revision admits one runtime edit;\n    neither the saved defaults nor another application instance are modified. }\n  LStore.Apply([NyxUpdate(NyxCollectionItem(LItem)\n    .WithValue(NyxTextField('status'), 'Attention'))], LRevision);\n  Context.State.Apply([\n    NyxStateValue(NyxTextState('service-context-summary'),\n      TNyxText('Marked ') + LItem.ID + TNyxText(' for review.')),\n    NyxStateValue(NyxBooleanState('service-context-ready'), False)]);\nend;\n\ninitialization\n  RegisterNyxCallback(NyxHandler('TServiceTableContextMenu'), TServiceTableContextMenu);\n\n  RegisterNyxCallback(NyxHandler('TServiceActionsButtonActivate'), TServiceActionsButtonActivate);\nend.\n", "draft" : "", "draftBase" : "", "pending" : false }