{ "version" : 1, "design" : "{ \"version\" : 3, \"collections\" : { \"version\" : 1, \"definitions\" : [{ \"key\" : \"people\", \"schema\" : [{ \"name\" : \"name\", \"default\" : { \"type\" : \"text\", \"value\" : \"\" }, \"domain\" : null }, { \"name\" : \"team\", \"default\" : { \"type\" : \"text\", \"value\" : \"\" }, \"domain\" : null }, { \"name\" : \"priority\", \"default\" : { \"type\" : \"integer\", \"value\" : 0 }, \"domain\" : null }], \"items\" : [{ \"id\" : \"ada\", \"values\" : [\"Ada Brooks\", \"Engineering\", 3] }, { \"id\" : \"grace\", \"values\" : [\"Grace Carter\", \"Design\", 2] }, { \"id\" : \"jordan\", \"values\" : [\"Jordan Ellis\", \"Engineering\", 1] }] }] }, \"title\" : \"People directory\", \"pages\" : [{ \"kind\" : \"page\", \"id\" : \"directory\", \"props\" : { \"layout\" : \"column\", \"gap\" : \"16\", \"padding\" : \"24\" }, \"children\" : [{ \"kind\" : \"heading\", \"id\" : \"directory-title\", \"props\" : { \"text\" : \"People worth getting to know\" }, \"children\" : [] }, { \"kind\" : \"label\", \"id\" : \"directory-intent\", \"props\" : { \"text\" : \"Find a person, choose an order, and keep the whole query in view.\" }, \"children\" : [] }, { \"kind\" : \"card\", \"id\" : \"directory-card\", \"props\" : { \"layout\" : \"column\", \"gap\" : \"12\", \"padding\" : \"20\" }, \"children\" : [{ \"kind\" : \"data-toolbar\", \"id\" : \"people-tools\", \"props\" : { \"part\" : \"data-toolbar\", \"text\" : \"\", \"layout\" : \"row\", \"gap\" : \"10\", \"projection-kind\" : \"row\", \"compound\" : \"true\" }, \"children\" : [{ \"kind\" : \"input\", \"id\" : \"people-tools-part-1\", \"props\" : { \"part\" : \"search\", \"text\" : \"Filter\", \"placeholder\" : \"Find a record...\", \"flex\" : \"1\" }, \"children\" : [] }, { \"kind\" : \"select\", \"id\" : \"people-tools-part-2\", \"props\" : { \"part\" : \"sort\", \"text\" : \"Sort by\", \"items\" : \"Original order\\nName\\nPriority, then name\", \"value\" : \"Original order\" }, \"children\" : [], \"nyx.contract\" : { \"version\" : 1, \"value\" : { \"type\" : \"text\", \"choices\" : [\"Original order\", \"Name\", \"Priority, then name\"] } }, \"nyx.data-toolbar.sort-domain\" : { \"version\" : 1, \"base\" : { \"type\" : \"text\" }, \"applied\" : { \"type\" : \"text\", \"choices\" : [\"Original order\", \"Name\", \"Priority, then name\"] } } }, { \"kind\" : \"button\", \"id\" : \"people-tools-part-3\", \"props\" : { \"part\" : \"create\", \"text\" : \"New record\", \"variant\" : \"primary\", \"emit\" : \"create\", \"visible\" : \"false\" }, \"children\" : [] }, { \"kind\" : \"button\", \"id\" : \"people-tools-part-4\", \"props\" : { \"part\" : \"refresh\", \"text\" : \"Refresh\", \"variant\" : \"primary\", \"emit\" : \"refresh\", \"visible\" : \"false\" }, \"children\" : [] }, { \"kind\" : \"button\", \"id\" : \"people-tools-clear\", \"props\" : { \"text\" : \"Clear\", \"aria-label\" : \"Clear search and sorting\", \"part\" : \"clear\", \"emit\" : \"clear\" }, \"children\" : [] }, { \"kind\" : \"column\", \"id\" : \"people-tools-query-context-0\", \"props\" : { \"part\" : \"query-context\", \"gap\" : \"6\", \"flex\" : \"1\", \"visible\" : \"true\" }, \"children\" : [{ \"kind\" : \"label\", \"id\" : \"people-tools-query-context-0-status\", \"props\" : { \"part\" : \"status\", \"text\" : \"People\", \"aria-label\" : \"Current query results\" }, \"children\" : [] }, { \"kind\" : \"button\", \"id\" : \"people-tools-query-context-0-details\", \"props\" : { \"part\" : \"details\", \"text\" : \"Query details\", \"aria-label\" : \"Show current filters and sorting\", \"visible\" : \"true\" }, \"children\" : [] }] }], \"nyx.contract\" : { \"version\" : 1, \"value\" : null, \"fields\" : [{ \"part\" : \"search\", \"domain\" : { \"type\" : \"text\" } }, { \"part\" : \"sort\", \"domain\" : { \"type\" : \"text\" } }] }, \"nyx.data-toolbar\" : { \"version\" : 1, \"mode\" : \"configured\", \"options\" : { \"version\" : 1, \"target\" : \"people-table\", \"search\" : \"name\", \"match\" : \"contains\", \"comparison\" : \"ascii-insensitive\", \"baseline\" : \"Original order\", \"sorts\" : [{ \"name\" : \"Name\", \"query\" : { \"version\" : 1, \"filter\" : null, \"order\" : [{ \"field\" : \"name\", \"kind\" : \"text\", \"direction\" : \"ascending\", \"textComparison\" : \"asciiInsensitive\" }] } }, { \"name\" : \"Priority, then name\", \"query\" : { \"version\" : 1, \"filter\" : null, \"order\" : [{ \"field\" : \"priority\", \"kind\" : \"integer\", \"direction\" : \"descending\", \"textComparison\" : \"exact\" }, { \"field\" : \"name\", \"kind\" : \"text\", \"direction\" : \"ascending\", \"textComparison\" : \"exact\" }] } }], \"queryContext\" : { \"version\" : 1, \"display\" : \"details\", \"caption\" : \"People\", \"button\" : \"Query details\" } } } }, { \"kind\" : \"table\", \"id\" : \"people-table\", \"props\" : { \"text\" : \"Table\", \"items\" : \"Name\\tStatus\\nExample\\tReady\", \"height\" : \"360\" }, \"collectionView\" : { \"version\" : 1, \"key\" : \"people\", \"scope\" : \"instance\", \"parent\" : \"\", \"columns\" : [{ \"field\" : \"name\", \"kind\" : \"text\", \"title\" : \"Name\", \"editable\" : false }, { \"field\" : \"team\", \"kind\" : \"text\", \"title\" : \"Team\", \"editable\" : false }, { \"field\" : \"priority\", \"kind\" : \"integer\", \"title\" : \"Priority\", \"editable\" : false }] }, \"children\" : [] }] }] }], \"components\" : [] }", "source" : "{ Nyx application views. BuildNyxDocument returns an owned document. }\nunit nyx.generated.view;\n\n{$mode delphi}{$H+}\n{$codepage utf8}\n\ninterface\n\nuses\n  nyx.text,\n  nyx.dates,\n  nyx.times,\n  nyx.colors,\n  nyx.images,\n  nyx.button.presentation,\n  nyx.button.configuration,\n  nyx.image.lifecycle,\n  nyx.design.tokens,\n  nyx.data.toolbar,\n  nyx.data.toolbar.query,\n  nyx.types,\n  nyx.responsive,\n  nyx.presentations,\n  nyx.content,\n  nyx.containers,\n  nyx.editing,\n  nyx.gestures,\n  nyx.contract,\n  nyx.flow.declarations,\n  nyx.flow.routes, nyx.flow.route.model,\n  nyx.data.rows,\n  nyx.flow.types,\n  nyx.flow,\n  nyx.logic,\n  nyx.logic.collections,\n  nyx.logic.json.editing,\n  nyx.logic.relations,\n  nyx.logic.joins,\n  nyx.logic.regex, nyx.regex.types, nyx.regex.replacement,\n  nyx.logic.programs,\n  nyx.numbers.decimal,\n  nyx.logic.http, nyx.http.types,\n  nyx.logic.files, nyx.files.save,\n  nyx.drawing,\n  nyx.canvas.geometry,\n  nyx.data,\n  nyx.state,\n  nyx.collections.view.types,\n  nyx.collections.selection,\n  nyx.collections.query,\n  nyx.collections,\n  nyx.collections.registry,\n  nyx.binding.types,\n  nyx.behavior,\n  nyx.scheduler,\n  nyx.events,\n  nyx.callbacks,\n  nyx.model,\n  nyx.controls;\n\nfunction BuildNyxDocument: TNyxDocument;\n\nimplementation\n\n// <nyx:views>\n// Studio synchronizes this builder; keep application helpers outside it.\nfunction BuildNyxDocument: TNyxDocument;\nvar\n  LDirectoryPage: INyxPage;\n  LDirectoryTitleHeading: INyxHeading;\n  LDirectoryIntentLabel: INyxLabel;\n  LDirectoryCard: INyxCard;\n  LPeopleToolsDataToolbar: INyxDataToolbar;\n  LPeopleToolsSearchInput: INyxInput;\n  LPeopleToolsSortSelect: INyxSelect;\n  LPeopleToolsCreateButton: INyxButton;\n  LPeopleToolsRefreshButton: INyxButton;\n  LPeopleToolsClearButton: INyxButton;\n  LPeopleToolsQueryContext0Column: INyxColumn;\n  LPeopleToolsQueryContext0StatusLabel: INyxLabel;\n  LPeopleToolsQueryContext0DetailsButton: INyxButton;\n  LPeopleTable: INyxTable;\nbegin\n  Result := TNyxDocument.Create;\n  try\n    // Admit each control to its owner before configuring it.\n    // A failed configuration releases the complete owned document.\n    Result.Title := 'People directory';\n\n    // Authored collection defaults; each application owns independent runtime stores.\n    Result.Collections.Define(\n      NyxCollection('people'),\n      NyxCollectionSchema\n        .Field('name', TNyxStateValue.FromText(''), NyxNoDomain)\n        .Field('team', TNyxStateValue.FromText(''), NyxNoDomain)\n        .Field('priority', TNyxStateValue.FromInteger(0), NyxNoDomain),\n      [\n        NyxCollectionItem(NyxItem(NyxCollection('people'), 'ada'))\n          .WithValue(NyxTextField('name'), 'Ada Brooks')\n          .WithValue(NyxTextField('team'), 'Engineering')\n          .WithValue(NyxIntegerField('priority'), 3),\n        NyxCollectionItem(NyxItem(NyxCollection('people'), 'grace'))\n          .WithValue(NyxTextField('name'), 'Grace Carter')\n          .WithValue(NyxTextField('team'), 'Design')\n          .WithValue(NyxIntegerField('priority'), 2),\n        NyxCollectionItem(NyxItem(NyxCollection('people'), 'jordan'))\n          .WithValue(NyxTextField('name'), 'Jordan Ellis')\n          .WithValue(NyxTextField('team'), 'Engineering')\n          .WithValue(NyxIntegerField('priority'), 1)\n      ]);\n\n\n    LDirectoryPage := NewNyxPage('directory');\n    Result.AddPage(LDirectoryPage);\n    LDirectoryPage.Configure\n      .Layout(nlColumn)\n      .Gap(16)\n      .Padding(24)\n      .Done;\n\n    LDirectoryTitleHeading := NewNyxHeading('directory-title');\n    LDirectoryPage.Add(LDirectoryTitleHeading);\n    LDirectoryTitleHeading.Configure\n      .Text('People worth getting to know')\n      .Done;\n\n    LDirectoryIntentLabel := NewNyxLabel('directory-intent');\n    LDirectoryPage.Add(LDirectoryIntentLabel);\n    LDirectoryIntentLabel.Configure\n      .Text('Find a person, choose an order, and keep the whole query in view.')\n      .Done;\n\n    LDirectoryCard := NewNyxCard('directory-card');\n    LDirectoryPage.Add(LDirectoryCard);\n    LDirectoryCard.Configure\n      .Layout(nlColumn)\n      .Gap(12)\n      .Padding(20)\n      .Done;\n\n    LPeopleToolsDataToolbar := NewNyxDataToolbar('people-tools', ncoDescriptor);\n    LDirectoryCard.Add(LPeopleToolsDataToolbar);\n    LPeopleToolsDataToolbar.Configure\n      .PartName(NyxPart('data-toolbar'))\n      .Text('')\n      .Layout(nlRow)\n      .Gap(10)\n      .ProjectAs(nkRow)\n      .Compound(True)\n      .Done;\n\n    LPeopleToolsDataToolbar.Contract\n      .NoValue\n      .Field(NyxPart('search'), NyxTextDomain)\n      .Field(NyxPart('sort'), NyxTextDomain);\n    SetNyxDataToolbarIntent(LPeopleToolsDataToolbar,\n      TNyxDataToolbarIntent.Configured(\n        NyxDataToolbarOptions(NyxControl('people-table'),\n          NyxTextField('name'))\n          .SearchMode(ntsmContains, nqtAsciiInsensitive)\n          .Baseline(NyxToolbarSort('Original order'))\n          .QueryContext(NyxDataToolbarQueryOptions.Display(ntqdDetails)\n            .Caption('People')\n            .ButtonText('Query details'))\n          .Sort(NyxToolbarSort('Name'),\n                        NyxCollectionQuery\n              .OrderBy(NyxTextField('name'), nsdAscending, nqtAsciiInsensitive))\n          .Sort(NyxToolbarSort('Priority, then name'),\n                        NyxCollectionQuery\n              .OrderBy(NyxIntegerField('priority'), nsdDescending)\n              .ThenBy(NyxTextField('name')))));\n\n    LPeopleToolsSearchInput := NewNyxInput('people-tools-part-1');\n    LPeopleToolsDataToolbar.Add(LPeopleToolsSearchInput);\n    LPeopleToolsSearchInput.Configure\n      .PartName(NyxPart('search'))\n      .Text('Filter')\n      .Placeholder('Find a record...')\n      .Flex(1)\n      .Done;\n\n    LPeopleToolsSortSelect := NewNyxSelect('people-tools-part-2');\n    LPeopleToolsDataToolbar.Add(LPeopleToolsSortSelect);\n    LPeopleToolsSortSelect.Configure\n      .PartName(NyxPart('sort'))\n      .Text('Sort by')\n      .Items(TNyxText('Original order') + TNyxText(#10) + TNyxText('Name') + TNyxText(#10) + TNyxText('Priority, then name'))\n      .Value('Original order')\n      .Done;\n\n    LPeopleToolsSortSelect.Contract\n      .Value(NyxTextDomain.Choices(['Original order', 'Name', 'Priority, then name']));\n    LPeopleToolsSortSelect.Extensions.SetValue(NyxExtension('nyx.data-toolbar.sort-domain'), NyxObject([\n      NyxField('version', NyxData(1)),\n      NyxField('base', NyxObject([\n        NyxField('type', NyxData('text'))\n      ])),\n      NyxField('applied', NyxObject([\n        NyxField('type', NyxData('text')),\n        NyxField('choices', NyxArray([\n          NyxData('Original order'),\n          NyxData('Name'),\n          NyxData('Priority, then name')\n        ]))\n      ]))\n    ]));\n\n    LPeopleToolsCreateButton := NewNyxButton('people-tools-part-3');\n    LPeopleToolsDataToolbar.Add(LPeopleToolsCreateButton);\n    LPeopleToolsCreateButton.Configure\n      .PartName(NyxPart('create'))\n      .Text('New record')\n      .Variant(nvPrimary)\n      .OnClick(NyxSemantic(nseCreate))\n      .Visible(False)\n      .Done;\n\n    LPeopleToolsRefreshButton := NewNyxButton('people-tools-part-4');\n    LPeopleToolsDataToolbar.Add(LPeopleToolsRefreshButton);\n    LPeopleToolsRefreshButton.Configure\n      .PartName(NyxPart('refresh'))\n      .Text('Refresh')\n      .Variant(nvPrimary)\n      .OnClick(NyxSemantic(nseRefresh))\n      .Visible(False)\n      .Done;\n\n    LPeopleToolsClearButton := NewNyxButton('people-tools-clear');\n    LPeopleToolsDataToolbar.Add(LPeopleToolsClearButton);\n    LPeopleToolsClearButton.Configure\n      .Text('Clear')\n      .AccessibleName('Clear search and sorting')\n      .PartName(NyxPart('clear'))\n      .OnClick(NyxSemantic(nseClear))\n      .Done;\n\n    LPeopleToolsQueryContext0Column := NewNyxColumn('people-tools-query-context-0');\n    LPeopleToolsDataToolbar.Add(LPeopleToolsQueryContext0Column);\n    LPeopleToolsQueryContext0Column.Configure\n      .PartName(NyxPart('query-context'))\n      .Gap(6)\n      .Flex(1)\n      .Visible(True)\n      .Done;\n\n    LPeopleToolsQueryContext0StatusLabel := NewNyxLabel('people-tools-query-context-0-status');\n    LPeopleToolsQueryContext0Column.Add(LPeopleToolsQueryContext0StatusLabel);\n    LPeopleToolsQueryContext0StatusLabel.Configure\n      .PartName(NyxPart('status'))\n      .Text('People')\n      .AccessibleName('Current query results')\n      .Done;\n\n    LPeopleToolsQueryContext0DetailsButton := NewNyxButton('people-tools-query-context-0-details');\n    LPeopleToolsQueryContext0Column.Add(LPeopleToolsQueryContext0DetailsButton);\n    LPeopleToolsQueryContext0DetailsButton.Configure\n      .PartName(NyxPart('details'))\n      .Text('Query details')\n      .AccessibleName('Show current filters and sorting')\n      .Visible(True)\n      .Done;\n\n    LPeopleTable := NewNyxTable('people-table');\n    LDirectoryCard.Add(LPeopleTable);\n    LPeopleTable.Configure\n      .Text('Table')\n      .Items(TNyxText('Name') + TNyxText(#9) + TNyxText('Status') + TNyxText(#10) + TNyxText('Example') + TNyxText(#9) + TNyxText('Ready'))\n      .Height(360)\n      .Done;\n    LPeopleTable.Binds\n      .Collection(\n        NyxCollectionView(NyxCollection('people'))\n          .Column(NyxTextField('name'), 'Name')\n          .Column(NyxTextField('team'), 'Team')\n          .Column(NyxIntegerField('priority'), 'Priority')\n          .Scoped(csInstance))\n      .Done;\n  except\n    Result.Free;\n    raise;\n  end;\nend;\n// </nyx:views>\n\nend.\n", "draft" : "", "draftBase" : "", "pending" : false }