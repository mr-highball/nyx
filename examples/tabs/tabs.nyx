{ "version" : 1, "design" : "{ \"version\" : 1, \"title\" : \"Untitled Nyx application\", \"pages\" : [{ \"kind\" : \"page\", \"id\" : \"ideas\", \"props\" : { \"layout\" : \"column\", \"gap\" : \"16\", \"padding\" : \"24\", \"text\" : \"Ideas\" }, \"children\" : [{ \"kind\" : \"heading\", \"id\" : \"ideas-heading\", \"props\" : { \"text\" : \"A place for every idea\" }, \"children\" : [] }, { \"kind\" : \"label\", \"id\" : \"ideas-intro\", \"props\" : { \"text\" : \"Switch sections without losing the notes you are writing.\" }, \"children\" : [] }, { \"kind\" : \"tabs\", \"id\" : \"idea-sections\", \"props\" : { \"layout\" : \"column\", \"gap\" : \"12\", \"padding\" : \"16\", \"text\" : \"Idea sections\", \"height\" : \"440\" }, \"children\" : [{ \"kind\" : \"tab\", \"id\" : \"plan\", \"props\" : { \"layout\" : \"column\", \"gap\" : \"12\", \"padding\" : \"20\", \"text\" : \"Plan\" }, \"children\" : [{ \"kind\" : \"heading\", \"id\" : \"plan-heading\", \"props\" : { \"text\" : \"Start with a small sketch\" }, \"children\" : [] }, { \"kind\" : \"memo\", \"id\" : \"plan-notes\", \"props\" : { \"text\" : \"Planning notes\", \"placeholder\" : \"What would you like to make?\", \"height\" : \"200\" }, \"children\" : [] }] }, { \"kind\" : \"tab\", \"id\" : \"details\", \"props\" : { \"layout\" : \"column\", \"gap\" : \"12\", \"padding\" : \"20\", \"text\" : \"Details\" }, \"children\" : [{ \"kind\" : \"heading\", \"id\" : \"details-heading\", \"props\" : { \"text\" : \"Make the details yours\" }, \"children\" : [] }, { \"kind\" : \"input\", \"id\" : \"idea-title\", \"props\" : { \"text\" : \"Project title\", \"placeholder\" : \"A brilliant little project\" }, \"children\" : [] }] }, { \"kind\" : \"tab\", \"id\" : \"review\", \"props\" : { \"layout\" : \"column\", \"gap\" : \"12\", \"padding\" : \"20\", \"text\" : \"Review\" }, \"children\" : [{ \"kind\" : \"heading\", \"id\" : \"review-heading\", \"props\" : { \"text\" : \"Keep making things\" }, \"children\" : [] }, { \"kind\" : \"label\", \"id\" : \"review-copy\", \"props\" : { \"text\" : \"Your notes and caret stay with their page. Return to Plan whenever you need.\" }, \"children\" : [] }] }] }] }], \"components\" : [] }", "source" : "{ Nyx application views. BuildNyxDocument returns an owned document. }\nunit nyx.generated.view;\n\n{$mode delphi}{$H+}\n{$codepage utf8}\n\ninterface\n\nuses\n  nyx.text,\n  nyx.dates,\n  nyx.times,\n  nyx.colors,\n  nyx.images,\n  nyx.image.lifecycle,\n  nyx.design.tokens,\n  nyx.types,\n  nyx.responsive,\n  nyx.presentations,\n  nyx.content,\n  nyx.containers,\n  nyx.editing,\n  nyx.gestures,\n  nyx.contract,\n  nyx.data,\n  nyx.state,\n  nyx.binding.types,\n  nyx.behavior,\n  nyx.scheduler,\n  nyx.events,\n  nyx.callbacks,\n  nyx.model,\n  nyx.controls;\n\nfunction BuildNyxDocument: TNyxDocument;\n\nimplementation\n\n// <nyx:views>\n// Studio synchronizes this builder; keep application helpers outside it.\nfunction BuildNyxDocument: TNyxDocument;\nvar\n  LIdeasPage: INyxPage;\n  LIdeasHeading: INyxHeading;\n  LIdeasIntroLabel: INyxLabel;\n  LIdeaSectionsTabs: INyxTabs;\n  LPlanTab: INyxTab;\n  LPlanHeading: INyxHeading;\n  LPlanNotesMemo: INyxMemo;\n  LDetailsTab: INyxTab;\n  LDetailsHeading: INyxHeading;\n  LIdeaTitleInput: INyxInput;\n  LReviewTab: INyxTab;\n  LReviewHeading: INyxHeading;\n  LReviewCopyLabel: INyxLabel;\nbegin\n  Result := TNyxDocument.Create;\n  try\n    // Admit each control to its owner before configuring it.\n    // A failed configuration releases the complete owned document.\n    Result.Title := 'Untitled Nyx application';\n\n    LIdeasPage := NewNyxPage('ideas');\n    Result.AddPage(LIdeasPage);\n    LIdeasPage.Configure\n      .Layout(nlColumn)\n      .Gap(16)\n      .Padding(24)\n      .Text('Ideas')\n      .Done;\n\n    LIdeasHeading := NewNyxHeading('ideas-heading');\n    LIdeasPage.Add(LIdeasHeading);\n    LIdeasHeading.Configure\n      .Text('A place for every idea')\n      .Done;\n\n    LIdeasIntroLabel := NewNyxLabel('ideas-intro');\n    LIdeasPage.Add(LIdeasIntroLabel);\n    LIdeasIntroLabel.Configure\n      .Text('Switch sections without losing the notes you are writing.')\n      .Done;\n\n    LIdeaSectionsTabs := NewNyxTabs('idea-sections');\n    LIdeasPage.Add(LIdeaSectionsTabs);\n    LIdeaSectionsTabs.Configure\n      .Layout(nlColumn)\n      .Gap(12)\n      .Padding(16)\n      .Text('Idea sections')\n      .Height(440)\n      .Done;\n\n    LPlanTab := NewNyxTab('plan');\n    LIdeaSectionsTabs.Add(LPlanTab);\n    LPlanTab.Configure\n      .Layout(nlColumn)\n      .Gap(12)\n      .Padding(20)\n      .Text('Plan')\n      .Done;\n\n    LPlanHeading := NewNyxHeading('plan-heading');\n    LPlanTab.Add(LPlanHeading);\n    LPlanHeading.Configure\n      .Text('Start with a small sketch')\n      .Done;\n\n    LPlanNotesMemo := NewNyxMemo('plan-notes');\n    LPlanTab.Add(LPlanNotesMemo);\n    LPlanNotesMemo.Configure\n      .Text('Planning notes')\n      .Placeholder('What would you like to make?')\n      .Height(200)\n      .Done;\n\n    LDetailsTab := NewNyxTab('details');\n    LIdeaSectionsTabs.Add(LDetailsTab);\n    LDetailsTab.Configure\n      .Layout(nlColumn)\n      .Gap(12)\n      .Padding(20)\n      .Text('Details')\n      .Done;\n\n    LDetailsHeading := NewNyxHeading('details-heading');\n    LDetailsTab.Add(LDetailsHeading);\n    LDetailsHeading.Configure\n      .Text('Make the details yours')\n      .Done;\n\n    LIdeaTitleInput := NewNyxInput('idea-title');\n    LDetailsTab.Add(LIdeaTitleInput);\n    LIdeaTitleInput.Configure\n      .Text('Project title')\n      .Placeholder('A brilliant little project')\n      .Done;\n\n    LReviewTab := NewNyxTab('review');\n    LIdeaSectionsTabs.Add(LReviewTab);\n    LReviewTab.Configure\n      .Layout(nlColumn)\n      .Gap(12)\n      .Padding(20)\n      .Text('Review')\n      .Done;\n\n    LReviewHeading := NewNyxHeading('review-heading');\n    LReviewTab.Add(LReviewHeading);\n    LReviewHeading.Configure\n      .Text('Keep making things')\n      .Done;\n\n    LReviewCopyLabel := NewNyxLabel('review-copy');\n    LReviewTab.Add(LReviewCopyLabel);\n    LReviewCopyLabel.Configure\n      .Text('Your notes and caret stay with their page. Return to Plan whenever you need.')\n      .Done;\n  except\n    Result.Free;\n    raise;\n  end;\nend;\n// </nyx:views>\n\nend.\n", "draft" : "", "draftBase" : "", "pending" : false }